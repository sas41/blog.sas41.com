# Optional for local development (only BIND_ADDRESS/BLOG_PORT are used).
# Copy to .env on the deployment host and fill all required values for hosting.
# Never commit .env.
# Use the same image name as REGISTRY/IMAGE_NAME in Forgejo Actions.
BLOG_IMAGE=forgejo.example.com/your-user/blog:latest

# Only reachable on this host by default. Change deliberately if the existing
# reverse proxy runs on another host; firewall these ports to that proxy only.
BIND_ADDRESS=127.0.0.1
BLOG_PORT=8081
COMMENTS_PORT=8082

# Generate: openssl rand -hex 32
REMARK_SECRET=

# Host nginx -> loopback published Docker port normally appears as the bridge
# gateway. Verify the direct peer on your host; do not broaden to 0.0.0.0/0.
BLOG_NETWORK_SUBNET=172.30.41.0/24
BLOG_NETWORK_GATEWAY=172.30.41.1
REMARK_TRUSTED_PROXY=172.30.41.1/32

# Initial reader login: anonymous. Enable email/another provider if preferred.
REMARK_AUTH_ANON=true
REMARK_AUTH_EMAIL_ENABLE=false
REMARK_EMAIL_FROM=
REMARK_SMTP_HOST=
REMARK_SMTP_PORT=587
REMARK_SMTP_USERNAME=
REMARK_SMTP_PASSWORD=
REMARK_SMTP_STARTTLS=true

# Sign in, click your username, and copy your user ID here. A durable email/OAuth
# identity is preferable to a browser-local anonymous identity for moderation.
REMARK_ADMIN_IDS=
REMARK_ADMIN_EMAIL=
REMARK_NOTIFY_ADMINS=none
# Optional API basic-auth credential for administrative CLI operations. This is
# not a replacement for a widget administrator identity. Generate a unique value.
REMARK_ADMIN_PASSWORD=
