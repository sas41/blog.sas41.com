{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel>
<title>{{ site.Title }}</title><link>{{ site.BaseURL }}</link><description>{{ site.Params.description }}</description><language>{{ site.Language.Locale }}</language>
<atom:link href="{{ "index.xml" | absURL }}" rel="self" type="application/rss+xml"/>
{{ range (where site.RegularPages "Type" "post").ByDate.Reverse }}
<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid isPermaLink="false">{{ printf "p/%s/" .Params.id | absURL }}</guid><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate><description>{{ .Description | htmlEscape }}</description></item>
{{ end }}
</channel></rss>
