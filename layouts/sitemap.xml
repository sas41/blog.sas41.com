{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.Home.Permalink }}</loc></url>
  {{ range site.RegularPages }}{{ if ne .Type "revision" }}<url><loc>{{ .Permalink }}</loc><lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</lastmod></url>{{ end }}{{ end }}
  {{ range site.Pages }}{{ if in (slice "taxonomy" "term") .Kind }}<url><loc>{{ .Permalink }}</loc></url>{{ end }}{{ end }}
</urlset>
